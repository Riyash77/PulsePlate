# ============================================================
# SBAMS / PULSE PLATE — Git Ignore Rules
# ============================================================

# Dependencies
node_modules/
*/node_modules/

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example
!*/.env.example

# Database local storage (PGlite binary data)
database/pgdata/
**/pgdata/

# Build artifacts & static output
dist/
*/dist/
build/
*/build/

# Tunnel binaries and credentials
tunnel/ngrok.exe
tunnel/ngrok.zip
tunnel/ngrok.yml
!tunnel/ngrok.example.yml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & AI Simulator Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel / Netlify local cache
.vercel/
.netlify/
