# PULSE PLATE Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
# For Render / Supabase / Neon, simply set DATABASE_URL (takes priority):
DATABASE_URL=
# Or configure individual DB parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseplate
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT Secret
JWT_SECRET=pulseplate_secret_key_kpriet_2024
JWT_EXPIRES_IN=7d

# Frontend URLs (for CORS)
ADMIN_PORTAL_URL=http://localhost:3001
STUDENT_PORTAL_URL=http://localhost:3002

# Email (optional - Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Firebase Cloud Messaging (optional)
FCM_SERVER_KEY=your_fcm_server_key
